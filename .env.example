# The installers save a per-user profile. This file is an optional checkout override.
# Environment variables > current-folder .env > saved user profile.
# ZENITH_HOME chooses a stable absolute profile/data/artifact location.
# ZENITH_CPU_THREADS=4
# For a separately started llama.cpp/vLLM-compatible local model server:
# AI_PROVIDER=localserver
# ZENITH_LOCAL_SERVER_URL=http://127.0.0.1:8080/v1
# ZENITH_LOCAL_SERVER_MODEL=zenith
# ZENITH_MODEL_LABEL=Zenith 9B

# Default: two-model local team with draft/review/synthesis. No paid API key.
# For lower RAM and latency choose AI_PROVIDER=huggingface.
# Optional local JSON roster; empty uses the bundled two-model configuration.
ZENITH_TEAM_CONFIG=
# Imported dataset excerpts per question (0 disables retrieval).
ZENITH_KNOWLEDGE_LIMIT=3
AI_PROVIDER=ensemble
HF_MODEL=Qwen/Qwen2.5-0.5B-Instruct
# For reproducibility, replace main with the model's exact Hub commit SHA.
HF_REVISION=main
ZENITH_DEVICE=auto
MAX_NEW_TOKENS=256
CONTEXT_TOKENS=2048
TEMPERATURE=0.4
# Optional legacy checkout storage override; omit to use persistent user storage.
# AGENT_DATA_DIR=data

# Optional: point to your evaluated LoRA adapter, then restart Zenith.
ZENITH_ADAPTER=

# Required for Docker or any public bind; at least 32 characters.
# Generate locally: python -c "import secrets; print(secrets.token_urlsafe(32))"
ZENITH_API_TOKEN=

# Optional local inference engine: AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# Experimental from-scratch model: AI_PROVIDER=tiny
# Optional override; otherwise uses ZENITH_HOME/artifacts/tiny/model.pt.
# ZENITH_TINY_CHECKPOINT=artifacts/tiny/model.pt
