# The installers save a per-user profile. This file is an optional checkout override.
# Environment variables > current-folder .env > saved user profile.
# ZENITH_HOME chooses a stable absolute profile/data/artifact location.
# ZENITH_CPU_THREADS=4
# For a separately started llama.cpp/vLLM-compatible local model server:
# AI_PROVIDER=localserver
# ZENITH_LOCAL_SERVER_URL=http://127.0.0.1:8080/v1
# ZENITH_LOCAL_SERVER_MODEL=zenith
# ZENITH_MODEL_LABEL=Zenith 9B

# Default: a bounded local team. Fast mode uses one routed contributor;
# thorough mode performs the configured draft/review/synthesis. No paid API key.
# For lower RAM and latency choose AI_PROVIDER=huggingface.
# Optional local JSON roster; empty uses the bundled two-model configuration.
ZENITH_TEAM_CONFIG=
# Imported dataset excerpts per question (0 disables retrieval).
ZENITH_KNOWLEDGE_LIMIT=3
ZENITH_RESPONSE_MODE=fast
# Auto uses concise replies for simple fast questions, full for code/detail.
# Brief always applies the smaller cap; full keeps MAX_NEW_TOKENS.
ZENITH_REPLY_STYLE=auto
ZENITH_FAST_MAX_NEW_TOKENS=96
ZENITH_FAST_HISTORY_TURNS=4
# Optional independently fitted, configuration-matched calibration artifact.
# Empty means uncalibrated; Zenith does not invent confidence percentages.
ZENITH_CALIBRATION_FILE=
ZENITH_ABSTAIN_THRESHOLD=0.6
AI_PROVIDER=ensemble
HF_MODEL=Qwen/Qwen2.5-0.5B-Instruct
# Pinned default checkpoint. When changing HF_MODEL, also select its revision.
HF_REVISION=7ae557604adf67be50417f59c2c2f167def9a775
ZENITH_DEVICE=auto
MAX_NEW_TOKENS=256
CONTEXT_TOKENS=2048
TEMPERATURE=0.4
# Optional legacy checkout storage override; omit to use persistent user storage.
# AGENT_DATA_DIR=data

# Optional: point to your evaluated LoRA adapter, then restart Zenith.
ZENITH_ADAPTER=

# Required for Docker or any public bind; at least 32 characters.
# Generate locally: python -c "import secrets; print(secrets.token_urlsafe(32))"
ZENITH_API_TOKEN=

# Optional local inference engine: AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# Experimental from-scratch model: AI_PROVIDER=tiny
# Optional override; otherwise uses ZENITH_HOME/artifacts/tiny/model.pt.
# ZENITH_TINY_CHECKPOINT=artifacts/tiny/model.pt

# Optional platform orchestration; existing installation defaults stay unchanged.
# AI_PROVIDER=orchestrated
# Native (default), fast, deep, coding, research, collaborative, local-only,
# security-research. Security-research needs a trusted MFA/scope-authorized caller;
# ordinary chat cannot activate it or execute tools.
ZENITH_ORCHESTRATION_MODE=native
ZENITH_NATIVE_PROVIDER=huggingface
ZENITH_REASONING_EFFORT=standard
# Explicitly permits sending conversation context to configured external models.
# Native/local-only still prohibit external model calls, regardless of this flag.
ZENITH_ALLOW_EXTERNAL=false
# Explicit exact account-discovered IDs, optional sourced capabilities/prices.
# Empty means no additional runtime is enabled. Never put a key in this JSON.
ZENITH_EXTERNAL_MODELS=[]
# Optional credentials are read at runtime, never bundled or stored by Zenith.
# Set OPENAI_API_KEY or ANTHROPIC_API_KEY privately in your own environment.
# Optional supervised task pilot. Existing chat/install works with all flags off.
# ZENITH_PLATFORM_ENABLED=false
# ZENITH_PLATFORM_RUNTIME_ENABLED=false
# ZENITH_PLATFORM_TOOLS_ENABLED=false
# ZENITH_PLATFORM_MEMORY_ENABLED=false
# ZENITH_PLATFORM_MAX_PENDING=32
# ZENITH_PLATFORM_PER_USER_PENDING=4
# ZENITH_PLATFORM_TASK_SECONDS=120

# Optional offline Python containers. Separate from the numeric subset verifier.
# Requires Linux Docker, builtin seccomp and cgroup-v2 resource controls.
# ZENITH_SANDBOX_ENABLED=false
# ZENITH_SANDBOX_IMAGE=sha256:<operator-reviewed-local-image-id>
# ZENITH_SANDBOX_SECONDS=10
